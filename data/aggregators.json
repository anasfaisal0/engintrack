    {
      "id": "totaljobs-uk",
      "name": "Totaljobs · graduate & placement",
      "kind": "aggregator",
      "sector": "job-board",
      "region": "UK",
      "ats": "custom",
      "adapter": "html-links",
      "chemEngRelevance": "medium",
      "careersUrl": "https://www.totaljobs.com/",
      "verified": "2026-09-02",
      "params": {
        "urls": "https://www.totaljobs.com/jobs/graduate-engineer|https://www.totaljobs.com/jobs/graduate-scheme|https://www.totaljobs.com/jobs/process-engineer|https://www.totaljobs.com/jobs/industrial-placement",
        "linkPattern": "href=\"(?<url>/job/(?<slug>[^/\"]+)/(?<employer>[^\"]*?)-job(?<id>\\d+))\"",
        "maxPages": "3",
        "titleFrom": "slug"
      },
      "notes": "StepStone platform, server-rendered, 25 results per page. The title is NOT in the anchor text (it is wrapped in emotion-styled spans), so the title and employer are taken from the URL path: /job/{title-slug}/{employer-slug}-job{id}. ⚠️ window.__PRELOADED_STATE__ holds only header/footer chrome, NOT results. ⚠️ Its sibling Milkround shares this markup and renders EMPTY anchors (href=\"#\"), so 'same platform' is never evidence a board is server-rendered."
    },
